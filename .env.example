# Copy to .env. Run ./scripts/setup-db.sh to also create .env.test for the test suite.
DATABASE_URL="postgresql://badam:badam@localhost:5432/badam?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Canonical public origin. Also pins the OIDC redirect_uri, so a forwarded Host header
# cannot rewrite it.
AUTH_URL="http://localhost:3000"
OIDC_ISSUER="https://accounts.google.com"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# Comma-separated. EMPTY DENIES EVERYONE - that is deliberate, see src/lib/users/gate.ts.
ALLOWED_EMAIL_DOMAINS=""
GIT_SHA=""
# e2e and local development ONLY. Never set this in a deployed environment: it enables a
# passwordless login that inherits any seeded user's memberships, including a super admin's.
ALLOW_TEST_LOGIN=""
# AUTH_SECRET must be DISTINCT per environment. Sharing one between an environment that
# has ALLOW_TEST_LOGIN set and one that does not lets a passwordless-minted session
# authenticate against the environment that disabled it.
